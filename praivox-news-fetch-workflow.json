    {
      "parameters": {
        "jsCode": "// Sab items ko ek array mein daal kar, wahi shape banao jo\n// /api/cron/ingest expect karta hai: { items: [...], sourceErrors: [...] }\n//\n// Phase 5 - Source failure detection: har RSS node \"onError: continueRegularOutput\"\n// ke sath set hai, matlab agar koi feed fail ho jaye to us branch ka\n// output khaali aa jata hai (poora workflow crash nahi hota). Yahan hum\n// har source ke naam se uske items count check karte hain - agar 0 hai,\n// us source ke liye ek sourceErrors entry bana dete hain, taake app ki\n// taraf Run History mein ye pata chal sake ke koi source us ghante fail hua tha.\nconst sourceBranches = [\n  { name: 'RSS - TheGuardian', label: 'The Guardian' },\n  { name: 'RSS - BBC World', label: 'BBC World' },\n  { name: 'RSS - NYT World', label: 'NYT World' },\n  { name: 'RSS - CoinDesk', label: 'CoinDesk' },\n  { name: 'RSS - CoinTelegraph', label: 'CoinTelegraph' },\n  { name: 'RSS - Decrypt', label: 'Decrypt' },\n];\n\nconst sourceErrors = [];\nfor (const branch of sourceBranches) {\n  let count = 0;\n  try {\n    count = $items(branch.name).length;\n  } catch (e) {\n    count = 0;\n  }\n  if (count === 0) {\n    sourceErrors.push({\n      source: branch.label,\n      message: '0 items received this run - feed may be down, rate-limited, or timed out.',\n    });\n  }\n}\n\nconst items = $input.all().map((entry) => ({\n  title: entry.json.title,\n  url: entry.json.url,\n  sourceName: entry.json.sourceName,\n  category: entry.json.category,\n  publishedAt: entry.json.publishedAt,\n}));\n\nreturn [{ json: { items, sourceErrors } }];"
      },
      "id": "ec805b16-c76b-4518-9ec9-acd0851d9bf9",
      "name": "Build Ingest Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
